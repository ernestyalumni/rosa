# rosa environment configuration
# Copy this file to .env and fill in your keys.
# .env is git-ignored and never committed.
#
# Priority order (first key found wins):
#   1. ANTHROPIC_API_KEY  → claude-sonnet-4-6
#   2. XAI_API_KEY        → grok-4-3
#   3. OPENAI_API_KEY     → gpt-5.5
#
# Override the model for whichever provider is active:
#   ROSA_MODEL=claude-opus-4-7

# ── LLM keys (uncomment one) ──────────────────────────────────────────────────

ANTHROPIC_API_KEY=sk-ant-...
# XAI_API_KEY=xai-...
# OPENAI_API_KEY=sk-...

# ── Model override (optional) ─────────────────────────────────────────────────

# ROSA_MODEL=claude-opus-4-7

# ── ROS 2 (optional) ─────────────────────────────────────────────────────────
# Set to the docker container name to route ros2 commands through docker exec.
# Leave unset if ros2 is installed natively on this machine.

# ROS_CONTAINER=rosa-ros2
